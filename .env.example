# Copy to .env and fill in. .env is git-ignored.

# --- LLM backend --------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Engagement integrity ----------------------------------------------
# HMAC key used to sign engagement scope files. Without it, swarmstrike
# refuses to run in autonomous mode: an unsigned scope cannot be trusted.
# Generate with:  openssl rand -hex 32
SWARMSTRIKE_SCOPE_KEY=

# --- Optional: a model that shortens tool output -----------------------
# swarmstrike compresses what an agent reads without any network. Where that
# is not enough, a model can summarise instead — but only if the signed
# engagement contract turns it on and names the endpoint, because the output
# then leaves this machine. Output holding credential material is never sent.
#
#   rules_of_engagement:
#     output_summarisation:
#       enabled: true
#       endpoint: "https://ai.exodata.cloud/v1"
#       model: "Qwen3_Coder-30B"
#
# Any OpenAI-compatible /v1 endpoint serves. The key goes here, not in the
# contract, so the contract can be shared with the client.
SWARMSTRIKE_SUMMARISER_KEY=

# --- Toolbox ------------------------------------------------------------
# Container image holding the assessment tooling. Agents never execute on
# the host; every command is dispatched into this container.
SWARMSTRIKE_TOOLBOX_IMAGE=swarmstrike/toolbox:latest

# Docker endpoint. For a disposable VPS runner, point this at that host.
# Left commented so it does not override a DOCKER_HOST already set in your
# shell; uncomment it only to pin one here.
#DOCKER_HOST=

# --- Budget guardrails --------------------------------------------------
# Hard ceiling per campaign. The orchestrator aborts when either is hit.
SWARMSTRIKE_MAX_USD=25.00
SWARMSTRIKE_MAX_TOKENS=20000000
