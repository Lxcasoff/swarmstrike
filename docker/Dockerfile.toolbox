# swarmstrike assessment toolbox.
#
# Agents never execute on the host. Every command they propose runs inside a
# throwaway container built from this image, with a read-only root filesystem,
# no capabilities beyond the raw sockets a SYN scan needs, and bind mounts
# limited to the campaign workspace.
#
#   docker build -t swarmstrike/toolbox:latest -f docker/Dockerfile.toolbox .
#
# Built on a pinned Debian rather than a rolling security distribution: every
# binary the tool catalog is allowed to dispatch is available here, and a report
# that states what was tested should be reproducible, which a rolling base is
# not. Pin the digest for a real engagement.
#
# Layers are deliberately few. A campaign may run on a host using the vfs
# storage driver, which copies the whole tree per layer instead of sharing it.
FROM mirror.gcr.io/library/debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PATH="/opt/tools/bin:${PATH}"

# Versions are explicit: a scanner's version is part of what an engagement
# should be able to state afterwards.
ARG TARGETARCH=amd64
ARG NUCLEI_VERSION=3.3.5
ARG HTTPX_VERSION=1.6.9
ARG SUBFINDER_VERSION=2.6.6
ARG DNSX_VERSION=1.2.1
ARG FFUF_VERSION=2.1.0
ARG TRIVY_VERSION=0.58.1

# --- Packaged tooling ------------------------------------------------------
# Adding a binary here does not make it reachable: it must also be in
# ALLOWED_BINARIES in swarmstrike/tools/catalog.py, and every command still
# passes the engagement scope guard before it runs.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates curl wget unzip git jq xsltproc \
        dnsutils whois iproute2 netcat-openbsd \
        nmap \
        nikto sslscan \
        sqlmap \
        smbclient snmp ldap-utils \
        python3 python3-minimal; \
    rm -rf /var/lib/apt/lists/*

# --- Release binaries ------------------------------------------------------
RUN set -eux; \
    mkdir -p /opt/tools/bin /tmp/dl; \
    cd /tmp/dl; \
    pdfetch() { \
        name="$1"; version="$2"; \
        curl -fsSL -o "${name}.zip" \
          "https://github.com/projectdiscovery/${name}/releases/download/v${version}/${name}_${version}_linux_${TARGETARCH}.zip"; \
        unzip -qo "${name}.zip" -d "${name}"; \
        install -m 0755 "${name}/${name}" /opt/tools/bin/; \
    }; \
    pdfetch nuclei    "${NUCLEI_VERSION}"; \
    pdfetch httpx     "${HTTPX_VERSION}"; \
    pdfetch subfinder "${SUBFINDER_VERSION}"; \
    pdfetch dnsx      "${DNSX_VERSION}"; \
    curl -fsSL -o ffuf.tar.gz \
      "https://github.com/ffuf/ffuf/releases/download/v${FFUF_VERSION}/ffuf_${FFUF_VERSION}_linux_${TARGETARCH}.tar.gz"; \
    tar -xzf ffuf.tar.gz ffuf; install -m 0755 ffuf /opt/tools/bin/; \
    curl -fsSL -o trivy.tar.gz \
      "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz"; \
    tar -xzf trivy.tar.gz trivy; install -m 0755 trivy /opt/tools/bin/; \
    cd /; rm -rf /tmp/dl

# --- Wordlist and templates ------------------------------------------------
# One compact content-discovery list at the path the tool catalog defaults to,
# rather than the multi-gigabyte collection: the catalog tells agents to use a
# focused list, and content discovery is the noisiest thing they can do.
RUN set -eux; \
    mkdir -p /usr/share/seclists/Discovery/Web-Content /opt/tools/nuclei-templates; \
    curl -fsSL -o /usr/share/seclists/Discovery/Web-Content/common.txt \
      "https://raw.githubusercontent.com/danielmiessler/SecLists/2024.1/Discovery/Web-Content/common.txt"; \
    HOME=/tmp nuclei -update-templates \
      -templates-directory /opt/tools/nuclei-templates -duc -silent || true; \
    chmod -R a+rX /opt/tools /usr/share/seclists

# --- Unprivileged user -----------------------------------------------------
# Tools run as this user. The container also drops all capabilities and mounts
# its root filesystem read-only, so the executor points HOME and the XDG
# directories at the tmpfs — several of these tools write a config file on
# first run and fail outright if they cannot.
RUN useradd --create-home --shell /usr/sbin/nologin --uid 1000 assessor \
    && mkdir -p /work && chown assessor:assessor /work

USER assessor
WORKDIR /work

# What is actually in here, for the report appendix and for preflight.
LABEL org.opencontainers.image.title="swarmstrike toolbox" \
      org.opencontainers.image.description="Assessment tooling for authorized penetration tests"

# No ENTRYPOINT: the executor passes the full argument vector, already validated
# against the engagement contract, as the container command.
CMD ["/bin/sh", "-c", "echo 'swarmstrike toolbox — the executor invokes this image with a command'"]
