# Keep the build context to the source. Campaign output in particular must
# never be baked into an image: it holds a client's unremediated findings.
.git
.gitignore
campaigns/
engagements/
loot/
evidence/
reports/
*.sqlite
*.sqlite3
*.db
*.jsonl
audit/

.env
*.key
engagement.yaml
engagement.local.yaml

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

tests/
docs/
.github/
.idea/
.vscode/
.DS_Store
